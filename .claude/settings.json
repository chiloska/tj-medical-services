{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python src/build.py)",
      "Bash(python3 src/build.py)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_console_messages",
      "Bash(git branch --show-current)",
      "Bash(gh project item-list*)",
      "Bash(gh project field-list*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(gh issue list*)",
      "PowerShell(gh issue view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh project item-list*)",
      "PowerShell(gh project field-list*)"
    ],
    "deny": [
      "Bash(git push *main)",
      "Bash(git push *main *)",
      "Bash(git push *master)",
      "Bash(git push *master *)",
      "Bash(git push *production)",
      "Bash(git push *production *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(git --* push*)",
      "Bash(env *git* push*)",
      "Bash(bash -c *push*)",
      "Bash(sh -c *push*)",
      "Bash(pwsh -c*push*)",
      "Bash(powershell -c*push*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *updateRef*)",
      "Bash(*ALLOW_MAIN_PUSH*)",
      "Bash(git config *hooksPath*)",
      "Bash(git *--output*)",
      "Bash(git *--no-index*)",
      "Bash(git *--ext-diff*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(gc *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "PowerShell(git push *main)",
      "PowerShell(git push *main *)",
      "PowerShell(git push *master)",
      "PowerShell(git push *master *)",
      "PowerShell(git push *production)",
      "PowerShell(git push *production *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--all*)",
      "PowerShell(git -C * push*)",
      "PowerShell(git -c * push*)",
      "PowerShell(git --* push*)",
      "PowerShell(env *git* push*)",
      "PowerShell(bash -c *push*)",
      "PowerShell(sh -c *push*)",
      "PowerShell(pwsh -c*push*)",
      "PowerShell(powershell -c*push*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh api *merge*)",
      "PowerShell(gh api *git/refs*)",
      "PowerShell(gh api *updateRef*)",
      "PowerShell(*ALLOW_MAIN_PUSH*)",
      "PowerShell(git config *hooksPath*)",
      "PowerShell(git *--output*)",
      "PowerShell(git *--no-index*)",
      "PowerShell(git *--ext-diff*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(head *.env*)",
      "PowerShell(tail *.env*)",
      "PowerShell(less *.env*)",
      "PowerShell(more *.env*)",
      "Edit(.githooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/rules/aim-kit.md)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*secret*.txt)",
      "Read(**/*password*.txt)"
    ],
    "ask": [
      "Bash(docker * stop*)",
      "Bash(docker * rm*)",
      "Bash(ssh * sudo*)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method*)",
      "Bash(gh workflow run*)",
      "Bash(gh release create*)",
      "Bash(./*deploy.sh*)",
      "Bash(bash *deploy.sh*)",
      "Bash(sh *deploy.sh*)",
      "Bash(./*promote.sh*)",
      "Bash(bash *promote.sh*)",
      "Bash(sh *promote.sh*)",
      "Bash(render deploys*)",
      "Bash(vercel *--prod*)",
      "Bash(ssh * docker compose*)",
      "Bash(claude -p*)",
      "Bash(claude --print*)",
      "PowerShell(docker * stop*)",
      "PowerShell(docker * rm*)",
      "PowerShell(ssh * sudo*)",
      "PowerShell(gh api *-X *)",
      "PowerShell(gh api *--method*)",
      "PowerShell(gh workflow run*)",
      "PowerShell(gh release create*)",
      "PowerShell(./*deploy.sh*)",
      "PowerShell(bash *deploy.sh*)",
      "PowerShell(sh *deploy.sh*)",
      "PowerShell(./*promote.sh*)",
      "PowerShell(bash *promote.sh*)",
      "PowerShell(sh *promote.sh*)",
      "PowerShell(render deploys*)",
      "PowerShell(vercel *--prod*)",
      "PowerShell(ssh * docker compose*)",
      "PowerShell(claude -p*)",
      "PowerShell(claude --print*)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "vercel"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/sprint_status.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_generated.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/rebuild.py\"",
            "timeout": 60,
            "statusMessage": "Rebuilding site..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "aim": {
      "source": {
        "source": "github",
        "repo": "chiloska/ai-manager"
      }
    }
  },
  "enabledPlugins": {
    "aim-kit@aim": true
  }
}
