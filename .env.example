# Copy to .env.local for local work; set the real values in Vercel → Project → Settings → Environment Variables
# (Preview and Production). Never commit real values.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp-enabled Twilio number, e.g. whatsapp:+16195550149 (Sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=

# Retell API key with the "webhook" badge; also signs custom-function requests
RETELL_API_KEY=
# Secret entered when creating the Cal.com webhook
CALCOM_WEBHOOK_SECRET=

# Twilio Content template SIDs (HX...). If one is missing and TWILIO_WHATSAPP_FROM is the Sandbox number,
# the same text is sent as a free-form body instead.
WA_TPL_CONFIRM_EN=
WA_TPL_CONFIRM_ES=
WA_TPL_RESCHEDULE_EN=
WA_TPL_RESCHEDULE_ES=
WA_TPL_CANCEL_EN=
WA_TPL_CANCEL_ES=
WA_TPL_ADDRESS_EN=
WA_TPL_ADDRESS_ES=

# true = log the message (including the full phone number) instead of sending it
NOTIFICATIONS_DRY_RUN=false
# true = log every raw Cal.com payload (contains patient name, email and phone). Use briefly to confirm the format.
NOTIFICATIONS_LOG_PAYLOADS=false

# Optional idempotency store shared across serverless instances (Upstash Redis via the Vercel Marketplace).
# Either pair works; without one, duplicates are only caught on the same warm instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
